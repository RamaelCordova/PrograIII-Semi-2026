        "            print(\"No permitido, monto debe ser al menos de $0.01\")\n",
        "        else:\n",
        "            impuesto_total, tramo = mi_calculadora.calcular_total(monto_ingresado)\n",
        "\n",
        "            if impuesto_total is not None:\n",
        "                print(\"\\n--- DETALLE DEL CÁLCULO ---\")\n",
        "                print(f\"Monto a procesar:   ${monto_ingresado:.2f}\")\n",
        "                print(f\"Rango aplicado:     Desde ${tramo['desde']} hasta ${tramo['hasta']}\")\n",
        "                print(f\"Desglose fórmula:   ({monto_ingresado:.2f} - {tramo['desde']}) / 1000 * {tramo['adicional']} + {tramo['precio']}\")\n",
        "                print(f\"VALOR A PAGAR:      ${impuesto_total:.2f}\")\n",
        "            else:\n",
        "                print(\"El monto ingresado está fuera de los rangos establecidos.\")\n",
        "\n",
        "    except ValueError:\n",
        "        print(\"Error: Por favor ingresa un número válido (usa punto para los decimales).\")\n",
        "\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    main()"
