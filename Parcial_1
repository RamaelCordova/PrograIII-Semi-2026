        "import math\n",
        "\n",
        "def solicitar_datos():\n",
        "    \"\"\"Permite al usuario ingresar números separados por comas.\"\"\"\n",
        "    print(\"=== SISTEMA DE ANÁLISIS ESTADÍSTICO ===\")\n",
        "    print(\"Ingresa tus datos numéricos separados por comas (ejemplo: 5, 10, 15.5, 20, 5)\")\n",
        "\n",
        "    while True:\n",
        "        entrada = input(\"Datos: \")\n",
        "        try:\n",
        "            datos = [float(x.strip()) for x in entrada.split(\",\")]\n",
        "            if len(datos) < 2:\n",
        "                print(\"Error: Por favor, ingresa al menos dos datos para el análisis estadístico.\")\n",
        "                continue\n",
        "            return datos\n",
        "        except ValueError:\n",
        "            print(\"Error: Asegúrate de ingresar solo números separados por comas.\")\n",
        "\n",
        "def calcular_media(datos):\n",
        "    suma = sum(datos)\n",
        "    return suma / len(datos)\n",
        "\n",
        "def calcular_mediana(datos):\n",
        "    datos_ordenados = sorted(datos)\n",
        "    n = len(datos_ordenados)\n",
        "    mitad = n // 2\n",
        "\n",
        "    if n % 2 == 0:\n",
        "        return (datos_ordenados[mitad - 1] + datos_ordenados[mitad]) / 2.0\n",
        "    else:\n",
        "        return datos_ordenados[mitad]\n",
        "\n",
        "def calcular_frecuencia(datos):\n",
        "    frecuencias = {}\n",
        "    for num in datos:\n",
        "        if num in frecuencias:\n",
        "            frecuencias[num] += 1\n",
        "        else:\n",
        "            frecuencias[num] = 1\n",
        "    return frecuencias\n",
        "\n",
        "def calcular_moda(frecuencias):\n",
        "    max_repeticiones = max(frecuencias.values())\n",
        "    modas = [num for num, frec in frecuencias.items() if frec == max_repeticiones]\n",
        "    return modas, max_repeticiones\n",
        "\n",
        "def calcular_varianza(datos, media):\n",
        "    n = len(datos)\n",
        "    suma_diferencias_cuadrado = sum((x - media) ** 2 for x in datos)\n",
        "    return suma_diferencias_cuadrado / (n - 1)\n",
        "\n",
        "def calcular_rango(datos):\n",
        "    return max(datos) - min(datos)\n",
        "\n",
        "def main():\n",
        "    datos = solicitar_datos()\n",
        "    n = len(datos)\n",
        "\n",
        "    media = calcular_media(datos)\n",
        "    mediana = calcular_mediana(datos)\n",
        "    frecuencias = calcular_frecuencia(datos)\n",
        "    modas, repeticiones = calcular_moda(frecuencias)\n",
        "    varianza = calcular_varianza(datos, media)\n",
        "\n",
        "    desviacion = math.sqrt(varianza)\n",
        "    rango = calcular_rango(datos)\n",
        "\n",
        "    print(\"\\n\" + \"=\"*40)\n",
        "    print(\" RESULTADOS DEL ANÁLISIS\")\n",
        "    print(\"=\"*40)\n",
        "    print(f\"Total de datos (n)    : {n}\")\n",
        "    print(f\"a. Media Aritmética   : {media:.4f}\")\n",
        "    print(f\"b. Mediana            : {mediana:.4f}\")\n",
        "\n",
        "    str_modas = \", \".join(map(str, modas))\n",
        "    print(f\"c. Moda               : {str_modas} (aparece {repeticiones} veces)\")\n",
        "\n",
        "    print(f\"d. Varianza (m)       : {varianza:.4f}\")\n",
        "    print(f\"e. Desviación Estándar: {desviacion:.4f}\")\n",
        "    print(f\"f. Desviación Típica  : {desviacion:.4f} *Mismo valor que la estándar*\")\n",
        "    print(f\"g. Rango              : {rango:.4f}\")\n",
        "\n",
        "    print(\"\\nh. Tabla de Frecuencias:\")\n",
        "    for valor, cantidad in sorted(frecuencias.items()):\n",
        "        print(f\"   Dato: {valor} -> Frecuencia: {cantidad}\")\n",
        "    print(\"=\"*40)\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    main()"
