        "\n",
        "            posicion1 = cantidad // 2 - 1\n",
        "            posicion2 = cantidad // 2\n",
        "\n",
        "            return (\n",
        "                datos[posicion1] +\n",
        "                datos[posicion2]\n",
        "            ) / 2\n",
        "\n",
        "        else:\n",
        "\n",
        "            return datos[cantidad // 2]\n",
        "\n",
        "    # ------------------------------------------\n",
        "    # MODA\n",
        "    # ------------------------------------------\n",
        "\n",
        "    def moda(self, serie):\n",
        "\n",
        "        datos = [\n",
        "            float(num)\n",
        "            for num in serie\n",
        "        ]\n",
        "\n",
        "        frecuencias = Counter(datos)\n",
        "\n",
        "        mayor = max(\n",
        "            frecuencias.values()\n",
        "        )\n",
        "\n",
        "        if mayor == 1:\n",
        "\n",
        "            return \"No existe moda\"\n",
        "\n",
        "        modas = []\n",
        "\n",
        "        for numero, frecuencia in frecuencias.items():\n",
        "\n",
        "            if frecuencia == mayor:\n",
        "\n",
        "                modas.append(numero)\n",
        "\n",
        "        return modas\n",
        "\n",
        "    # ------------------------------------------\n",
        "    # VARIANZA\n",
        "    # ------------------------------------------\n",
        "\n",
        "    def varianza(self, serie):\n",
        "\n",
        "        media = self.media(serie)\n",
        "\n",
        "        suma = reduce(\n",
        "            lambda acum, num:\n",
        "            acum +\n",
        "            (float(num) - media) ** 2,\n",
        "            serie,\n",
        "            0\n",
        "        )\n",
        "\n",
        "        return suma / len(serie)\n",
        "\n",
        "    # ------------------------------------------\n",
        "    # DESVIACION ESTANDAR\n",
        "    # ------------------------------------------\n",
        "\n",
        "    def desviacion_estandar(self, serie):\n",
        "\n",
        "        return self.varianza(serie) ** 0.5\n",
        "\n",
        "    # ------------------------------------------\n",
        "    # DESVIACION TIPICA\n",
        "    # ------------------------------------------\n",
        "\n",
        "    def desviacion_tipica(self, serie):\n",
        "\n",
        "        return self.desviacion_estandar(serie)\n",
        "\n",
        "    # ------------------------------------------\n",
        "    # RANGO\n",
        "    # ------------------------------------------\n",
        "\n",
        "    def rango(self, serie):\n",
        "\n",
        "        datos = [\n",
        "            float(num)\n",
        "            for num in serie\n",
        "        ]\n",
        "\n",
        "        return max(datos) - min(datos)\n",
        "\n",
        "    # ------------------------------------------\n",
        "    # FRECUENCIA\n",
        "    # ------------------------------------------\n",
        "\n",
        "    def frecuencia(self, serie):\n",
        "\n",
        "        datos = [\n",
        "            float(num)\n",
        "            for num in serie\n",
        "        ]\n",
        "\n",
        "        return dict(\n",
        "            Counter(datos)\n",
